{
  "manifest_version": 3,
  "name": "TikTok Packer",
  "version": "1.8.3",
  "description": "Overlay product names on TikTok Shop packing-list PDFs for thermal label printing.",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TikTok Packer"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "pdfjs/pdf.worker.min.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
